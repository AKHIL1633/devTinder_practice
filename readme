--------------------------------------------------------

middleware and routehandler 


const express=require("express");
const app=express();

// route handler is the function which send the response
// it is nothing the middleware 
//it will go to through the chain in middleware through requests 


// Get /users ==>user will fall into this 
//those who send the response back it will be the route handler 
//in the middle of it there will be middleware 



app.use("/",(req,res,next)=>{
    // res.send("Handling /route");
    next();
});

app.get("/user",(req,res,next)=>{
    console.log("Handling the route user 2!!");
    // res.send("2nd Route Handler");
    next();
});

app.get("/user",(req,res,next)=>{
    console.log("Handling the route user!!");
    next();
});

app.listen(7777,()=>{
    console.log("Server is successfully listening on port 7777....");
});






